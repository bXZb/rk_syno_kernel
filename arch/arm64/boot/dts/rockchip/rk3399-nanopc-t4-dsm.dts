/*
 * FriendlyElec NanoPC-T4 DSM loader device tree overlay target.
 *
 * Keep the real hardware compatible string so Rockchip platform drivers bind,
 * but expose the model DSM expects from the DS423 junior ramdisk.
 */

/dts-v1/;
#include "rk3399-nanopc-t4.dts"

/ {
	model = "synology_rtd1619b_ds423";
	compatible = "friendlyelec,nanopc-t4", "friendlyarm,nanopc-t4", "rockchip,rk3399";

	ir-receiver {
		status = "disabled";
	};

	gpio-keys {
		status = "disabled";
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		drm_logo: drm-logo@00000000 {
			compatible = "rockchip,drm-logo";
			reg = <0x0 0x0 0x0 0x0>;
		};
	};

	internal_slot@1 {
		protocol_type = "sata";

		ahci {
			pcie_root = "0000:00:00.0,00.0";
			ata_port = <0x00>;
		};
	};

	internal_slot@2 {
		protocol_type = "sata";

		ahci {
			pcie_root = "0000:00:00.0,00.0";
			ata_port = <0x01>;
		};
	};

	internal_slot@3 {
		protocol_type = "sata";

		ahci {
			pcie_root = "0000:00:00.0,00.0";
			ata_port = <0x02>;
		};
	};

	internal_slot@4 {
		protocol_type = "sata";

		ahci {
			pcie_root = "0000:00:00.0,00.0";
			ata_port = <0x03>;
		};
	};

	internal_slot@5 {
		protocol_type = "sata";

		ahci {
			pcie_root = "0000:00:00.0,00.0";
			ata_port = <0x04>;
		};
	};

	internal_slot@6 {
		protocol_type = "sata";

		ahci {
			pcie_root = "0000:00:00.0,00.0";
			ata_port = <0x05>;
		};
	};
};

&display_subsystem {
	ports = <&vopb_out>;
	logo-memory-region = <&drm_logo>;

	route {
		route_hdmi: route-hdmi {
			status = "okay";
			logo,uboot = "logo.bmp";
			logo,kernel = "logo.bmp";
			logo,mode = "center";
			charge_logo,mode = "center";
			connect = <&vopb_out_hdmi>;
		};
	};
};

&gpu {
	compatible = "arm,mali-t860", "arm,mali-midgard";
	operating-points-v2 = <&gpu_opp_table>;
	status = "okay";
};

&iep {
	status = "okay";
};

&iep_mmu {
	status = "okay";
};

&ir_rx {
	rockchip,pins = <0 RK_PA6 1 &pcfg_pull_none>;
};

&rkvdec {
	status = "disabled";
};

&vdec {
	status = "okay";
};

&vdec_mmu {
	status = "okay";
};

&spi1 {
	status = "okay";

	spidev@0 {
		compatible = "rohm,dh2228fv";
		reg = <0>;
		spi-max-frequency = <10000000>;
	};
};

&usbdrd_dwc3_0 {
	dr_mode = "host";
	status = "okay";
};

&usbdrd_dwc3_1 {
	dr_mode = "host";
	status = "okay";
};

&vbus_typec {
	regulator-always-on;
	regulator-boot-on;
};

&u2phy0_otg {
	phy-supply = <&vbus_typec>;
};

&u2phy1_otg {
	phy-supply = <&vcc5v0_host0>;
};

&vopb {
	rockchip,grf = <&grf>;
};

&vopl {
	status = "disabled";
};

&vopl_mmu {
	status = "disabled";
};

&vpu {
	status = "okay";
};

&vpu_mmu {
	status = "okay";
};
