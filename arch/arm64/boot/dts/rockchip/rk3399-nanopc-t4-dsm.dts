/*
 * FriendlyElec NanoPC-T4 DSM loader device tree overlay target.
 *
 * Keep the real hardware compatible string so Rockchip platform drivers bind,
 * but expose the model DSM expects from the DS124 junior ramdisk.
 */

/dts-v1/;
#include "rk3399-nanopc-t4.dts"

/ {
	model = "synology_rtd1619b_ds124";
	compatible = "friendlyelec,nanopc-t4", "friendlyarm,nanopc-t4", "rockchip,rk3399";

	ir-receiver {
		status = "disabled";
	};

	internal_slot@1 {
		protocol_type = "sata";

		rtk_ahci {
			ata_port = <0x01>;
		};
	};
};

&fusb0 {
	status = "disabled";
};

&tcphy0 {
	status = "disabled";
};

&tcphy1 {
	status = "disabled";
};

&u2phy0 {
	status = "disabled";
};

&u2phy0_host {
	status = "disabled";
};

&u2phy0_otg {
	status = "disabled";
};

&u2phy1 {
	status = "disabled";
};

&u2phy1_host {
	status = "disabled";
};

&u2phy1_otg {
	status = "disabled";
};

&usbdrd3_0 {
	status = "disabled";
};

&usbdrd3_1 {
	status = "disabled";
};

&usbdrd_dwc3_0 {
	status = "disabled";
};

&usbdrd_dwc3_1 {
	status = "disabled";
};

&usb_host0_ehci {
	status = "disabled";
};

&usb_host0_ohci {
	status = "disabled";
};

&usb_host1_ehci {
	status = "disabled";
};

&usb_host1_ohci {
	status = "disabled";
};
